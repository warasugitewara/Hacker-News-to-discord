# ── Required ──────────────────────────────────────────────
# Gemini API Key — https://aistudio.google.com/app/apikeys
GEMINI_API_KEY=your-gemini-api-key-here

# Discord Webhook URL — Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ── Optional (defaults shown) ─────────────────────────────
# Gemini model to use
# GEMINI_MODEL=gemini-3.5-flash
# Number of stories in the digest
# HN_MAX_ARTICLES=5
# How many recent stories to rank before picking the top ones
# HN_CANDIDATE_POOL=100
# Look-back window in hours
# HN_LOOKBACK_HOURS=24
